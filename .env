# Advanced Hybrid RAG runtime configuration. Loaded automatically by
# `docker compose`. Override any value here without rebuilding the images.

# HuggingFace token, only needed at BUILD time if a model repo is gated.
HF_TOKEN=

# Ports (host -> container)
UI_SERVICE_PORT=8000

# ── GPU (6 GB): only llm_service uses it ──────────────────────────────────
GPU_DEVICE_ID=0

# ── llm_service: SGLang + Qwen3.5-4B-AWQ ─────────────────────────────────
LLM_MODEL=LostGentoo/Qwen3.5-4B-AWQ
# Fraction of VRAM SGLang reserves for weights + KV/mamba cache. The AWQ
# checkpoint keeps embeddings / linear-attention layers in BF16 (~4 GB for the
# language model), so a 6 GB card needs most of it.
LLM_MEM_FRACTION=0.92
LLM_CONTEXT_LEN=8192
# Concurrent requests (also the CUDA-graph batch size).
LLM_MAX_RUNNING=2
# The mamba cache is sized for LLM_MAX_RUNNING requests. (Do not add
# --language-only: in SGLang 0.5.10 it means encoder-disaggregated mode.)
LLM_EXTRA_ARGS=--max-mamba-cache-size 4
# Answer budget (tokens) and validation thresholds.
RAG_ANSWER_TOKENS=1024
RAG_MIN_GROUNDED=0.7
RAG_MASK_PII=true

# ── rag_service: chunking, embeddings, hybrid retrieval, reranking ──────
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBED_DEVICE=cpu
RERANK_DEVICE=cpu
# Snowball stemmer for BM25 keyword search: english, german, french, ...
BM25_LANGUAGE=english
QDRANT_COLLECTION=chunks
RAG_CHUNK_TOKENS=400
RAG_RETRIEVE_K=30
RAG_RERANK_TOP_K=8
RAG_RERANK_MIN_SCORE=0.15
RAG_SYNC_ON_STARTUP=true

# ── orchestrator_service: validation retry loop ─────────────────────────
RAG_MAX_RETRIES=1
RAG_RETRY_ADD_WEB=true

# ── MCP servers (FastMCP, inside rag_service) ────────────────────────────
# Bearer token for /mcp/gdrive and /mcp/websearch.
MCP_TOKEN=sV2VQKoHeQv1gtOeZCbGjc3J8E516WTQMXdM-rMYcM8
MCP_TIMEOUT_SEC=20
# Google Drive: put credentials.json in ./secrets/gdrive and run
#   python rag_service/src/mcp_servers/gdrive_auth.py --secrets secrets/gdrive
# The Drive is one account (yours), so only these app roles may search it.
GDRIVE_ENABLED=true
GDRIVE_AUTH=oauth
GDRIVE_ALLOWED_ROLES=master,admin
# Web search: ddgs needs no key; tavily / brave need WEBSEARCH_API_KEY.
WEBSEARCH_ENABLED=true
WEBSEARCH_PROVIDER=ddgs
WEBSEARCH_API_KEY=

# ── ui_service: Chainlit chat (/chat) ────────────────────────────────────
# Signs Chainlit's session JWT (generate a new one with `chainlit create-secret`).
CHAINLIT_AUTH_SECRET=uOfKA2EdHEKI9aFnqPbzOvGn02uhatpy1eNPYlIIbyrYiZl5TZGG_xskKqGbqbzq
# Comma-separated URL prefixes users may connect as their own MCP servers in
# the chat (empty = users cannot add MCP servers). Example:
#   MCP_USER_ALLOWED_URLS=https://mcp.example.com,https://tools.mycompany.com/mcp
MCP_USER_ALLOWED_URLS=
# Persist chat threads in MinIO (sidebar history, resume, feedback).
CHAT_HISTORY_ENABLED=true

# ── ocr_service: Docling (CPU) ───────────────────────────────────────────
DOCLING_DEVICE=cpu
# OCR engine for bitmap regions and scans: rapidocr | auto | easyocr
# (easyocr needs the docling[easyocr] extra in ocr_service/requirements.txt)
DOCLING_OCR_ENGINE=rapidocr
# Comma-separated OCR languages. Empty keeps the engine default (RapidOCR: ch,
# which also reads Latin text). Example: iso:en or latin
DOCLING_OCR_LANG=
# TableFormer mode: accurate | fast (fast is ~2x quicker on CPU)
DOCLING_TABLE_MODE=accurate
# Render scale for picture crops (1.0 = 72 dpi)
DOCLING_IMAGES_SCALE=2.0
# Extra model passes for LaTeX formulas / code blocks (slower)
DOCLING_DO_FORMULA_ENRICHMENT=false
DOCLING_DO_CODE_ENRICHMENT=false
# Documents converted at once
OCR_CONCURRENCY=1
INCLUDE_PICTURES=true

# MinIO (object store) 
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=ocr
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_CONSOLE_PORT=9001
# Max simultaneous PUTs per document (decoupled from OCR_BATCH_SIZE_*).
MINIO_UPLOAD_CONCURRENCY=8

# Auth service
AUTH_SERVICE_PORT=8002

MASTER_USERNAME=master
MASTER_PASSWORD=changeme-please
# How long a login lasts before the user must sign in again.
SESSION_TTL_HOURS=12
# Set to true when the UI is served over HTTPS (sets the Secure cookie flag).
COOKIE_SECURE=false
