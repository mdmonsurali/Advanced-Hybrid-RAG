# Advanced Hybrid RAG runtime configuration. Loaded automatically by
# `docker compose`. Override any value here without rebuilding the images.

# HuggingFace token, only needed at BUILD time if a model repo is gated.
HF_TOKEN=

# Prebuilt images: CD publishes ui, auth, rag and orchestrator to GitHub Container
# Registry on every merge to main. Set AHR_REGISTRY=ghcr.io/mdmonsurali/ (with the
# trailing slash) to run those instead of building them, then:
#   docker compose pull ui_service auth_service rag_service orchestrator_service
#   docker compose up -d
# AHR_TAG picks a version: latest, or the commit SHA of a merge. Empty = local builds.
AHR_REGISTRY=
AHR_TAG=latest

# Ports (host -> container)
UI_SERVICE_PORT=8000

# ── GPU (6 GB): llm_service, or ocr_service while GPU_SWAP hands it to OCR
GPU_DEVICE_ID=0

# ── llm_service: SGLang + Qwen3.5-4B-AWQ ─────────────────────────────────
LLM_MODEL=LostGentoo/Qwen3.5-4B-AWQ
# Fraction of VRAM SGLang reserves for weights + KV/mamba cache. The AWQ
# checkpoint keeps embeddings / linear-attention layers in BF16 (~4 GB for the
# language model), so a 6 GB card needs most of it.
LLM_MEM_FRACTION=0.92
LLM_CONTEXT_LEN=8192
# Concurrent requests (also the CUDA-graph batch size).
LLM_MAX_RUNNING=2
# The mamba cache is sized for LLM_MAX_RUNNING requests. (Do not add
# --language-only: in SGLang 0.5.10 it means encoder-disaggregated mode.)
LLM_EXTRA_ARGS=--max-mamba-cache-size 4
# Answer budget (tokens) and validation thresholds.
RAG_ANSWER_TOKENS=1024
RAG_MIN_GROUNDED=0.7
RAG_MASK_PII=true

# ── rag_service: chunking, embeddings, hybrid retrieval, reranking ──────
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
EMBED_DEVICE=cpu
RERANK_DEVICE=cpu
# Snowball stemmer for BM25 keyword search: english, german, french, ...
BM25_LANGUAGE=english
# One collection per embedding model (rag_service refuses to mix models).
QDRANT_COLLECTION=chunks_qwen3
RAG_CHUNK_TOKENS=400
RAG_RETRIEVE_K=30
RAG_RERANK_TOP_K=8
RAG_RERANK_MIN_SCORE=0.15
RAG_SYNC_ON_STARTUP=true
# Describe figures (charts, diagrams) with the vision LLM at ingest so their
# content is searchable. Crops smaller than RAG_FIGURE_MIN_PX on a side are
# skipped as logos/icons; bigger ones are downscaled to RAG_FIGURE_MAX_PX.
RAG_FIGURE_DESCRIPTIONS=true
RAG_FIGURE_MIN_PX=150
RAG_FIGURE_MAX_PX=1024
RAG_FIGURE_MAX_PER_DOC=40

# ── orchestrator_service: validation retry loop ─────────────────────────
RAG_MAX_RETRIES=1
RAG_RETRY_ADD_WEB=true

# ── Orchestrator service: GPU swap ───────────────────────────────────────
# OCR (Docling on CUDA) and the LLM (SGLang) take turns on the GPU: an OCR
# batch stops llm_service, chat waits until the batch is done, then the LLM
# restarts (~6 min cold start). Docs indexed meanwhile get LLM metadata and
# figure descriptions afterwards. false = OCR on CPU, LLM always up.
GPU_SWAP=true
# Seconds OCR must be idle before the GPU goes back to the LLM (lets
# back-to-back uploads share one OCR window).
GPU_SWAP_IDLE_SEC=30
# How long to wait for llm_service to become healthy after a swap.
SWAP_HEALTH_TIMEOUT_SEC=900
# GPU lease TTL; holders renew every TTL/3, so a crashed caller can't pin the GPU.
GPU_LEASE_TTL_SEC=120

# ── MCP servers (FastMCP, inside rag_service) ────────────────────────────
# Bearer token for /mcp/gdrive and /mcp/websearch.
MCP_TOKEN=CHANGEME
MCP_TIMEOUT_SEC=20
# Google Drive: put credentials.json in ./secrets/gdrive and run
#   python rag_service/src/mcp_servers/gdrive_auth.py --secrets secrets/gdrive
# The Drive is one account (yours), so only these app roles may search it.
GDRIVE_ENABLED=true
GDRIVE_AUTH=oauth
GDRIVE_ALLOWED_ROLES=master,admin
# Web search: ddgs needs no key; tavily / brave need WEBSEARCH_API_KEY.
WEBSEARCH_ENABLED=true
WEBSEARCH_PROVIDER=ddgs
WEBSEARCH_API_KEY=

# ── ui_service: Chainlit chat (/chat) ────────────────────────────────────
# Signs Chainlit's session JWT (generate a new one with `chainlit create-secret`).
CHAINLIT_AUTH_SECRET=CHANGEME
# Comma-separated URL prefixes users may connect as their own MCP servers in
# the chat (empty = users cannot add MCP servers). Example:
#   MCP_USER_ALLOWED_URLS=https://mcp.example.com,https://tools.mycompany.com/mcp
MCP_USER_ALLOWED_URLS=
# Persist chat threads in MinIO (sidebar history, resume, feedback).
CHAT_HISTORY_ENABLED=true

# ── ocr_service: Docling (CPU; CUDA worker when GPU_SWAP=true) ───────────
# Device of the always-on converter (DOCX, and PDFs when GPU_SWAP=false).
DOCLING_DEVICE=cpu
# CPU threads per Docling converter.
DOCLING_NUM_THREADS=4
# RapidOCR backend in the GPU worker: torch (CUDA) | onnxruntime (CPU)
DOCLING_GPU_OCR_BACKEND=torch
# OCR engine for bitmap regions and scans: rapidocr | auto | easyocr
# (easyocr needs the docling[easyocr] extra in ocr_service/requirements.txt)
DOCLING_OCR_ENGINE=rapidocr
# Comma-separated OCR languages. Empty keeps the engine default (RapidOCR: ch,
# which also reads Latin text). Example: iso:en or latin
DOCLING_OCR_LANG=
# TableFormer mode: accurate | fast (fast is ~2x quicker on CPU)
DOCLING_TABLE_MODE=accurate
# Render scale for picture crops (1.0 = 72 dpi)
DOCLING_IMAGES_SCALE=2.0
# Extra model passes for LaTeX formulas / code blocks (slower)
DOCLING_DO_FORMULA_ENRICHMENT=false
DOCLING_DO_CODE_ENRICHMENT=false
# Documents converted at once
OCR_CONCURRENCY=1
INCLUDE_PICTURES=true

# MinIO (object store) 
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=ocr
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_CONSOLE_PORT=9001
# Max simultaneous PUTs per document (decoupled from OCR_BATCH_SIZE_*).
MINIO_UPLOAD_CONCURRENCY=8

# Auth service
AUTH_SERVICE_PORT=8002

MASTER_USERNAME=master
MASTER_PASSWORD=CHANGEME
# How long a login lasts before the user must sign in again.
SESSION_TTL_HOURS=12
# Set to true when the UI is served over HTTPS (sets the Secure cookie flag).
COOKIE_SECURE=false

# ── Langfuse (langfuse_service: self-hosted tracing, scores, prompts) ────
# UI: http://localhost:${LANGFUSE_PORT}  (login with LANGFUSE_INIT_USER_*)
LANGFUSE_PORT=3000
# Turn tracing off everywhere without touching code.
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=local
# Project API key pair. langfuse_service creates the project with exactly these
# keys on first start; every service uses them to send traces.
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_BASE_URL=http://langfuse_service:3000
# First Langfuse login (created once; change the password in the UI later).
LANGFUSE_INIT_USER_EMAIL=admin@local.dev
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME
# Langfuse server secrets.
LANGFUSE_NEXTAUTH_SECRET=CHANGEME
LANGFUSE_SALT=CHANGEME
LANGFUSE_ENCRYPTION_KEY=CHANGEME_64_hex_chars_openssl_rand_hex_32
LANGFUSE_POSTGRES_PASSWORD=CHANGEME
LANGFUSE_CLICKHOUSE_PASSWORD=CHANGEME
LANGFUSE_REDIS_PASSWORD=CHANGEME
# Container memory caps (about 5.5 GB in total; the web UI needs 2G at startup).
LANGFUSE_WEB_MEMORY_LIMIT=2G
LANGFUSE_WORKER_MEMORY_LIMIT=1G
LANGFUSE_CLICKHOUSE_MEMORY_LIMIT=2G

# ── Prompts (llm_service) ─────────────────────────────────────────────────
# Where prompts come from: langfuse | local (the constants in llm_service/src/prompts)
PROMPT_SOURCE=langfuse
# Label fetched for every prompt: production, staging, latest or any custom label.
# A prompt without a version under this label uses its production version.
PROMPT_LABEL=production
# Pin single prompts to a version number (overrides PROMPT_LABEL for them), e.g.
#   PROMPT_VERSIONS=rag/answer:3,rag/judge:2
PROMPT_VERSIONS=
# Seconds a fetched prompt is cached before it is refreshed in the background.
PROMPT_CACHE_TTL=60
